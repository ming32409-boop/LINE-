# Node.js >=22. cp .env.example .env ; never commit .env.
GITHUB_REPOSITORY=ming32409-boop/LINE-
SITE_URL=https://ming32409-boop.github.io/LINE-/
API_URL=https://YOUR_WORKER.YOUR_SUBDOMAIN.workers.dev
WORKER_NAME=your-line-sticker-worker
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
KV_NAMESPACE_ID=YOUR_KV_NAMESPACE_ID
TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY
# Private: uploaded only to Worker secrets, never copied to dist.
VERTEX_API_KEY=CHANGE_ME
TURNSTILE_SECRET=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
# Optional: wrangler login can replace API token authentication.
# CLOUDFLARE_API_TOKEN=
# Optional self-hosted alternative (then GEMINI_API_KEY replaces VERTEX_API_KEY):
# GEMINI_WEB_BASE_URL=https://your-gemini-service.example
# GEMINI_API_KEY=
# DEFAULT_MODEL=gemini-3.1-flash-image-preview
# PAGES_REF=main
# Optional public links; blank = hidden. No original-author defaults.
STORE_URL=
DONATION_URL=
CHAT_MAKER_URL=
REPLAY_URL=
CONTACT_URL=

# Optional public metadata in exported LINE submission instructions.
CREATOR_COPYRIGHT=
CREATOR_ENGLISH=
CREATOR_CHINESE=
